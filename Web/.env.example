# Copia como Web/.env (no se versiona) o define estas variables en el entorno del despliegue.
ATALAYA_ENV=production
# Obligatoria en producción (mín. 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Rutas (por defecto: <repo>/artifacts y <repo>/data)
# ATALAYA_ARTIFACTS_DIR=
# ATALAYA_DATA_DIR=
# Saltos de proxy inverso de confianza (Render = 1)
ATALAYA_TRUST_PROXY_HOPS=1
# Asistente opcional (desactivado por defecto)
ASSISTANT_ENABLED=0
GEMINI_API_KEY=
