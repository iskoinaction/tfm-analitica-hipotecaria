{
  "name": "atalaya-site",
  "private": true,
  "version": "2.0.0",
  "description": "Web de presentación del TFM — Atalaya · Analítica Hipotecaria",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs && vite",
    "build": "node scripts/sync-data.mjs && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.4.1",
    "js-yaml": "4.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
